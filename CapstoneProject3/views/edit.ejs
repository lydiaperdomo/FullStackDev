


<%- include("partials/header") %>
<h1>Edit Post</h1>

<!-- UPDATE FORM -->
<form action="/posts/<%= post.id %>/edit" method="POST" class="form">

  <p>
    <input type="text" name="title" value="<%= post.title %>" class="Title">
  </p>

  <p>
    <textarea name="content" class="Content-box"><%= post.content %></textarea>
  </p>

  <div class="button-row">
    <button type="submit">Update</button>
  </div>

</form>

<!-- DELETE FORM (SEPARATE - IMPORTANT) -->
<form action="/posts/<%= post.id %>/delete" method="POST" class="inline-form">
  <button type="submit">Delete</button>
</form>

<%- include("partials/footer") %>


